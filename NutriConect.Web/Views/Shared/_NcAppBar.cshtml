@using Microsoft.AspNetCore.Identity
@using NutriConect.Business.Entities
@inject UserManager<User> UserManager
@{
    var active = ViewData["ActiveNav"] as string ?? "";
    var appUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var fullName = appUser?.FullName ?? "";
    var initials = string.IsNullOrWhiteSpace(fullName)
        ? "?"
        : string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
    var accountHref = appUser is Nutritionist ? "/Nutritionist/Profile" : "/Client/Profile";
}
<header class="appbar">
    <div class="appbar__inner">
        <button class="appbar__burger" id="navBurger" type="button" aria-expanded="false" aria-controls="mobileNav" aria-label="Abrir menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
        </button>
        <a class="nc-brand" asp-controller="Home" asp-action="Index" style="text-decoration:none">
            <span class="nc-brand__mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
                </svg>
            </span>
            NutriConect
        </a>

        <nav class="appbar__links">
            <a class="nc-navlink @(active == "inicio" ? "nc-navlink--active" : "")" asp-controller="Home" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                Início
            </a>
            <a class="nc-navlink @(active == "nutricionistas" ? "nc-navlink--active" : "")" asp-controller="Nutritionist" asp-action="Search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                Nutricionistas
            </a>
            <a class="nc-navlink @(active == "receitas" ? "nc-navlink--active" : "")" asp-controller="Recipe" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                Receitas
            </a>
            <a class="nc-navlink @(active == "dicas" ? "nc-navlink--active" : "")" asp-controller="Tip" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6" /><path d="M10 22h4" /><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5" /></svg>
                Dicas
            </a>
        </nav>

        <div class="appbar__right">
            <button class="theme-toggle theme-toggle--appbar" id="themeToggle" type="button" aria-pressed="false" aria-label="Alternar tema">
                <span class="theme-toggle__icon--moon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z" /></svg>
                </span>
                <span class="theme-toggle__icon--sun" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg>
                </span>
                <span class="theme-toggle__label">Tema</span>
            </button>
            @if (appUser is not null)
            {
                <div class="usermenu-wrap">
                    <button class="usermenu usermenu--btn" id="userMenuTrigger" type="button" aria-expanded="false" aria-haspopup="true">
                        <span class="usermenu__name">@fullName</span>
                        <span class="nc-avatar nc-avatar--sm">@initials</span>
                    </button>
                    <div class="usermenu-dropdown" id="userMenuDropdown" hidden>
                        <a class="usermenu-dropdown__item" href="@accountHref">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            Minha conta
                        </a>
                        <hr />
                        <form method="post" asp-controller="Account" asp-action="Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="usermenu-dropdown__item usermenu-dropdown__item--danger">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                                Sair
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a class="nc-btn nc-btn--secondary nc-btn--sm" asp-controller="Account" asp-action="Login">Entrar</a>
            }
        </div>
    </div>

    <nav class="appbar__mobile" id="mobileNav" hidden>
        <a class="mobile-navlink @(active == "inicio" ? "mobile-navlink--active" : "")" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
            Início
        </a>
        <a class="mobile-navlink @(active == "nutricionistas" ? "mobile-navlink--active" : "")" asp-controller="Nutritionist" asp-action="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            Nutricionistas
        </a>
        <a class="mobile-navlink @(active == "receitas" ? "mobile-navlink--active" : "")" asp-controller="Recipe" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
            Receitas
        </a>
        <a class="mobile-navlink @(active == "dicas" ? "mobile-navlink--active" : "")" asp-controller="Tip" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6" /><path d="M10 22h4" /><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5" /></svg>
            Dicas
        </a>
    </nav>
</header>

<script>
    (function () {
        const b = document.getElementById('navBurger');
        const m = document.getElementById('mobileNav');
        if (!b || !m) return;
        b.addEventListener('click', e => {
            e.stopPropagation();
            const open = !m.hidden;
            m.hidden = open;
            b.setAttribute('aria-expanded', String(!open));
        });
        document.addEventListener('click', () => {
            m.hidden = true;
            b.setAttribute('aria-expanded', 'false');
        });
        m.addEventListener('click', e => e.stopPropagation());
    })();
</script>

@if (appUser is not null)
{
    <script>
        (function () {
            const t = document.getElementById('userMenuTrigger');
            const d = document.getElementById('userMenuDropdown');
            if (!t || !d) return;
            t.addEventListener('click', e => {
                e.stopPropagation();
                const open = !d.hidden;
                d.hidden = open;
                t.setAttribute('aria-expanded', String(!open));
            });
            document.addEventListener('click', () => {
                d.hidden = true;
                t.setAttribute('aria-expanded', 'false');
            });
        })();
    </script>
}

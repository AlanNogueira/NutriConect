@model string
@if (!string.IsNullOrEmpty(Model))
{
    <div class="nc-alert nc-alert--success" style="margin-bottom:var(--space-5)" role="alert">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px"><path d="M9 12l2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
        <div class="nc-alert__body"><p style="margin:0">@Model</p></div>
    </div>
}

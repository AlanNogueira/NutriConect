@model NutriConect.Business.ViewModels.NutritionistSearchViewModel
@using NutriConect.Business.Enums
@using NutriConect.Business.Extensions
@{
    Layout = "_NcLayout";
    ViewData["Title"] = "Buscar profissionais";
    ViewData["ActiveNav"] = "nutricionistas";

    string FilterUrl(NutritionistSpecialtyEnum? spec, string? mod) =>
        Url.Action("Search", "Nutritionist", new
        {
            query = Model.Query,
            specialty = spec.HasValue ? spec.Value.ToString() : null,
            modality = mod
        })!;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/nutritionist-search.css" asp-append-version="true" />
}

<main class="page" style="max-width:1280px">
    <header class="page-head">
        <h1>Encontre seu nutricionista</h1>
        <p>Filtre por especialidade, modalidade e disponibilidade. Selecione um profissional para entrar em contato.</p>
    </header>

    <div class="find-grid">

        <aside class="nc-card nc-card--pad filters sticky">
            <div
                style="display:flex;align-items:center;gap:var(--space-2);font-weight:var(--weight-bold);margin-bottom:var(--space-5)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" style="width:17px;height:17px">
                    <line x1="4" y1="21" x2="4" y2="14" />
                    <line x1="4" y1="10" x2="4" y2="3" />
                    <line x1="12" y1="21" x2="12" y2="12" />
                    <line x1="12" y1="8" x2="12" y2="3" />
                    <line x1="20" y1="21" x2="20" y2="16" />
                    <line x1="20" y1="12" x2="20" y2="3" />
                    <line x1="1" y1="14" x2="7" y2="14" />
                    <line x1="9" y1="8" x2="15" y2="8" />
                    <line x1="17" y1="16" x2="23" y2="16" />
                </svg>
                Filtros
            </div>

            <div class="filter-block">
                <div class="filter-block__label">Especialidade</div>
                <div style="display:flex;flex-wrap:wrap;gap:var(--space-2)">
                    <a class="nc-chip @(Model.Specialty == null ? "nc-chip--active" : "")"
                       href="@FilterUrl(null, Model.Modality)">Todas</a>
                    @foreach (var spec in Enum.GetValues<NutritionistSpecialtyEnum>())
                    {
                        <a class="nc-chip @(Model.Specialty == spec ? "nc-chip--active" : "")"
                           href="@FilterUrl(spec, Model.Modality)">@spec.GetDisplayName()</a>
                    }
                </div>
            </div>

            <div class="filter-block">
                <div class="filter-block__label">Modalidade</div>
                <div style="display:flex;flex-wrap:wrap;gap:var(--space-2)">
                    <a class="nc-chip @(Model.Modality == null ? "nc-chip--active" : "")"
                       href="@FilterUrl(Model.Specialty, null)">Todas</a>
                    <a class="nc-chip @(Model.Modality == "online" ? "nc-chip--active" : "")"
                       href="@FilterUrl(Model.Specialty, "online")">Online (vídeo)</a>
                    <a class="nc-chip @(Model.Modality == "inperson" ? "nc-chip--active" : "")"
                       href="@FilterUrl(Model.Specialty, "inperson")">Presencial</a>
                </div>
            </div>
        </aside>

        <section>
            <form method="get" asp-controller="Nutritionist" asp-action="Search" class="searchbar">
                @if (Model.Specialty.HasValue)
                {
                    <input type="hidden" name="specialty" value="@Model.Specialty.Value" />
                }
                @if (!string.IsNullOrEmpty(Model.Modality))
                {
                    <input type="hidden" name="modality" value="@Model.Modality" />
                }
                <div class="nc-input-group">
                    <span class="nc-input-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                    </span>
                    <input class="nc-input" name="query" value="@Model.Query" placeholder="Buscar por nome ou título" />
                </div>
                <button type="submit" class="nc-btn nc-btn--secondary">Buscar</button>
            </form>

            <div class="resmeta">
                <span class="muted" style="font-size:var(--text-sm)">
                    <b style="color:var(--color-text)">@Model.Total profissiona@(Model.Total == 1 ? "l" : "is")</b>
                    encontrado@(Model.Total == 1 ? "" : "s")
                </span>
                @if (!string.IsNullOrEmpty(Model.Query) || Model.Specialty.HasValue ||
                !string.IsNullOrEmpty(Model.Modality))
                {
                    <a href="@Url.Action("Search", "Nutritionist")" class="nc-btn nc-btn--ghost nc-btn--sm">Limpar
                        filtros</a>
                    }
                </div>

                <div class="nutri-list" id="nutri-list">
                    @if (!Model.Nutritionists.Any())
                    {
                        <div class="nc-card" style="padding:var(--space-10);text-align:center;color:var(--color-text-muted)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                                 stroke-linejoin="round" style="width:40px;height:40px;margin-bottom:var(--space-3);opacity:.4">
                                <circle cx="11" cy="11" r="8" />
                                <line x1="21" y1="21" x2="16.65" y2="16.65" />
                            </svg>
                            <p style="margin:0;font-size:var(--text-md)">Nenhum profissional encontrado.</p>
                            <p style="margin:var(--space-2) 0 0;font-size:var(--text-sm)">Tente outros filtros ou <a
                                href="@Url.Action("Search", "Nutritionist")"
                                style="color:var(--color-primary-soft-text)">veja todos</a>.</p>
                            </div>
                        }
                else
                        {
                            @for (int i = 0; i < Model.Nutritionists.Count; i++)
                            {
                                var n = Model.Nutritionists[i];
                                <article class="nc-card nutri @(i == 0 ? "sel" : "")" data-id="@n.Id" data-initials="@n.Initials"
                                         data-name="@n.DisplayName" data-online="@n.AcceptsOnline.ToString().ToLower()"
                                         data-inperson="@n.AcceptsInPerson.ToString().ToLower()" onclick="selectCard(this)">
                                    <div style="display:flex;gap:var(--space-4)">
                                        <span class="nc-avatar nc-avatar--xl">
                                            @n.Initials
                                            @if (n.AcceptsOnline)
                                            {
                                                <span class="nc-avatar__status nc-avatar__status--online"></span>
                                            }
                                        </span>
                                        <div style="flex:1;min-width:0">
                                            <div style="display:flex;align-items:center;gap:var(--space-2);flex-wrap:wrap">
                                                <a href="@Url.Action("Public", "Nutritionist", new { id = n.Id })"
                                                   style="font-size:var(--text-lg);font-weight:var(--weight-bold);text-decoration:none"
                                                   onclick="event.stopPropagation()">@n.DisplayName</a>
                                                @if (n.CrnVerified)
                                                {
                                                    <span class="nc-badge nc-badge--teal">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                             stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px">
                                                            <path d="M9 12l2 2 4-4" />
                                                            <circle cx="12" cy="12" r="9" />
                                                        </svg>
                                                        CRN
                                                    </span>
                                                }
                                                @if (n.TopRated)
                                                {
                                                    <span class="nc-badge nc-badge--coral">★ Top avaliada</span>
                                                }
                                            </div>
                                            <p class="muted" style="font-size:var(--text-sm);margin:2px 0 var(--space-2)">
                                                @n.ProfessionalTitle@(n.YearsOfExperience > 0 ? $" · {n.YearsOfExperience} anos" : "")
                                            </p>
                                            @if (n.ReviewCount > 0)
                                            {
                                                <div style="display:inline-flex;align-items:center;gap:4px;font-size:var(--text-sm)">
                                                    <svg viewBox="0 0 24 24" fill="currentColor"
                                                         style="width:15px;height:15px;color:var(--color-warning,#f59e0b)">
                                                        <path d="m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.6 5.9 20.8l1.2-6.8-5-4.8 6.9-.9z" />
                                                    </svg>
                                                    <b>@n.AverageDisplay</b>
                                                    <span class="muted">(@n.ReviewCount)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @if (n.Specialties.Any())
                                    {
                                        <div style="display:flex;flex-wrap:wrap;gap:var(--space-2);margin:var(--space-4) 0">
                                            @foreach (var spec in n.Specialties)
                                            {
                                                <span class="nc-badge nc-badge--neutral">@spec.GetDisplayName()</span>
                                            }
                                        </div>
                                    }

                                    <div
                                        style="display:flex;align-items:center;gap:var(--space-3);padding-top:var(--space-4);border-top:1px solid var(--color-border)">
                                        <div style="flex:1">
                                            @if (n.AvailableForNewPatients)
                                            {
                                                <span class="nc-badge nc-badge--success nc-badge--dot">Disponível</span>
                                            }
                                            else
                                            {
                                                <span class="nc-badge nc-badge--neutral nc-badge--dot">Indisponível</span>
                                            }
                                            <div
                                                style="font-size:var(--text-lg);font-weight:var(--weight-extra);margin-top:var(--space-2)">
                                                @if (n.PricePerSession > 0)
                                                {
                                                    <span>R$ @n.PricePerSession.ToString("F0")<span
                                                        style="font-size:var(--text-xs);font-weight:500;color:var(--color-text-subtle)">/consulta</span></span>
                                                    }
                                        else
                                                    {
                                                        <span style="color:var(--color-text-muted);font-size:var(--text-md)">Consultar
                                                            preço</span>
                                                        }
                                                    </div>
                                                </div>
                                                @if (n.AcceptsOnline)
                                                {
                                                    <span class="nc-badge nc-badge--info">Online</span>
                                                }
                                                @if (n.AcceptsInPerson)
                                                {
                                                    <span class="nc-badge nc-badge--neutral">Presencial</span>
                                                }
                                                <a class="nc-btn nc-btn--secondary"
                                                   href="@Url.Action("Public", "Nutritionist", new { id = n.Id })"
                                                   onclick="event.stopPropagation()">Ver perfil</a>
                                                <button class="nc-btn nc-btn--primary" type="button"
                                                        onclick="event.stopPropagation();selectCard(this.closest('.nutri'))">Contato</button>
                                            </div>
                                        </article>
                                    }
                                }
                            </div>
                        </section>

                        <aside class="nc-card contact-panel sticky" style="overflow:hidden" id="contact-panel">
                            @if (Model.Nutritionists.Any())
                            {
                                var first = Model.Nutritionists[0];
                                <div
                                    style="padding:var(--space-5);display:flex;align-items:center;gap:var(--space-3);border-bottom:1px solid var(--color-border)">
                                    <span class="nc-avatar nc-avatar--lg" id="panel-av">@first.Initials</span>
                                    <div style="flex:1;min-width:0">
                                        <div style="font-weight:var(--weight-bold)" id="panel-name">@first.DisplayName</div>
                                        <div style="display:flex;gap:6px;margin-top:6px" id="panel-badges">
                                            @if (first.AcceptsOnline)
                                            {
                                                <span class="nc-badge nc-badge--info">Vídeo</span>
                                            }
                                            @if (first.AcceptsInPerson)
                                            {
                                                <span class="nc-badge nc-badge--neutral">Presencial</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="panel-empty">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                    <p style="margin:0;font-size:var(--text-sm)">Selecione um profissional para entrar em contato.</p>
                                </div>
                            }

                            @if (Model.Nutritionists.Any())
                            {
                                <div style="padding:var(--space-5)">
                                    @if (Model.CanMessage)
                                    {
                                        <p class="muted" style="font-size:var(--text-sm);margin:0 0 var(--space-4)">Envie uma mensagem para
                                            tirar dúvidas antes de agendar.</p>
                                            <div class="nc-field">
                                                <label class="nc-label" for="contact-subject">Assunto</label>
                                                <select class="nc-select" id="contact-subject"
                                                        asp-items="Html.GetEnumSelectList<NutriConect.Business.Enums.ContactSubjectEnum>()"></select>
                                            </div>
                                            <div class="nc-field" style="margin-top:var(--space-4)">
                                                <label class="nc-label" for="contact-message">Mensagem</label>
                                                <textarea class="nc-textarea" id="contact-message" maxlength="1900"
                                                          placeholder="Olá, gostaria de saber se você atende…"></textarea>
                                            </div>
                                            <button type="button" class="nc-btn nc-btn--primary nc-btn--block" style="margin-top:var(--space-4)"
                                                    onclick="sendContactMessage()">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                     stroke-linejoin="round" style="width:15px;height:15px">
                                                    <line x1="22" y1="2" x2="11" y2="13" />
                                                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                                                </svg>
                                                Enviar mensagem
                                            </button>
                                        }
                    else
                                        {
                                            <p class="muted" style="font-size:var(--text-sm);margin:0 0 var(--space-4)">O envio de mensagens está
                                                disponível para contas de cliente.</p>
                                            }
                                            <button class="nc-btn nc-btn--accent nc-btn--block" style="margin-top:var(--space-3)"
                                                    onclick="alert('Agendamento em breve!')">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                     stroke-linejoin="round" style="width:15px;height:15px">
                                                    <rect x="3" y="4" width="18" height="18" rx="2" />
                                                    <line x1="16" y1="2" x2="16" y2="6" />
                                                    <line x1="8" y1="2" x2="8" y2="6" />
                                                    <line x1="3" y1="10" x2="21" y2="10" />
                                                </svg>
                                                Agendar consulta
                                            </button>
                                        </div>
                                    }
                                </aside>

                            </div>
                        </main>

                        @section Scripts {
                            <script>
                                let selectedNutritionistId = document.querySelector('.nutri.sel')?.dataset.id ?? null;

                                function selectCard(el) {
                                    document.querySelectorAll('.nutri').forEach(c => c.classList.remove('sel'));
                                    el.classList.add('sel');
                                    selectedNutritionistId = el.dataset.id;

                                    const av = document.getElementById('panel-av');
                                    const name = document.getElementById('panel-name');
                                    const badges = document.getElementById('panel-badges');
                                    if (!av) return;

                                    av.textContent = el.dataset.initials;
                                    name.textContent = el.dataset.name;

                                    const parts = [];
                                    if (el.dataset.online === 'true') parts.push('<span class="nc-badge nc-badge--info">Vídeo</span>');
                                    if (el.dataset.inperson === 'true') parts.push('<span class="nc-badge nc-badge--neutral">Presencial</span>');
                                    badges.innerHTML = parts.join('');
                                }

                                async function sendContactMessage() {
                                    if (!selectedNutritionistId || !window.ncChat) return;

                                    const subjectEl = document.getElementById('contact-subject');
                                    const messageEl = document.getElementById('contact-message');
                                    const text = messageEl.value.trim();
                                    const subject = subjectEl.options[subjectEl.selectedIndex]?.text ?? '';

                                    const initialMessage = text ? `[${subject}] ${text}` : null;
                                    await window.ncChat.startWith(parseInt(selectedNutritionistId, 10), initialMessage);
                                    messageEl.value = '';
                                }
                            </script>
                        }

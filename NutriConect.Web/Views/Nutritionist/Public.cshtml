@model NutriConect.Business.ViewModels.NutritionistPublicViewModel
@{
    Layout = "_NcLayout";
    ViewData["Title"] = Model.DisplayName;
    ViewData["ActiveNav"] = "nutricionistas";
    var price = Model.PricePerSession > 0
        ? Model.PricePerSession.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))
        : "A consultar";
    var reviewMsg = TempData["Success"] as string ?? TempData["Error"] as string;
}

@functions {
    const string FullStar = "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\" style=\"width:16px;height:16px;color:var(--color-warning,#f59e0b)\"><path d=\"m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.6 5.9 20.8l1.2-6.8-5-4.8 6.9-.9z\"/></svg>";
    const string EmptyStar = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\" style=\"width:16px;height:16px;color:var(--color-border)\"><path d=\"m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.6 5.9 20.8l1.2-6.8-5-4.8 6.9-.9z\"/></svg>";

    static string Stars(int filled)
    {
        var html = "";
        for (var i = 1; i <= 5; i++) html += i <= filled ? FullStar : EmptyStar;
        return html;
    }

    static string RelativeTime(DateTimeOffset when)
    {
        var diff = DateTimeOffset.UtcNow - when;
        if (diff.TotalMinutes < 1) return "agora";
        if (diff.TotalMinutes < 60) return $"há {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24) return $"há {(int)diff.TotalHours} h";
        if (diff.TotalDays < 2) return "ontem";
        if (diff.TotalDays < 7) return $"há {(int)diff.TotalDays} dias";
        if (diff.TotalDays < 30) return $"há {(int)(diff.TotalDays / 7)} semana(s)";
        return when.ToLocalTime().ToString("dd/MM/yyyy");
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/components/reviews.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/nutritionist-public.css" asp-append-version="true" />
}

<main class="page" style="max-width:1100px">
    <nav class="nc-breadcrumb" style="margin-bottom:var(--space-4)">
        <a asp-controller="Home" asp-action="Index">Início</a>
        <span style="display:inline-flex;align-items:center;width:16px;height:16px;color:var(--color-text-soft)">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </span>
        <span style="color:var(--color-text)">@Model.DisplayName</span>
    </nav>

    @if (TempData["Success"] is string ok)
    {
        <div class="nc-alert nc-alert--success" style="margin-bottom:var(--space-5)">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;width:16px;height:16px"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <div>@ok</div>
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="nc-alert nc-alert--danger" style="margin-bottom:var(--space-5)">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;width:16px;height:16px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>@err</div>
        </div>
    }

    <section class="nc-card" style="overflow:hidden;margin-bottom:var(--space-6)">
        <div style="height:140px;background:linear-gradient(120deg,var(--color-cover-from, var(--color-primary-soft)),var(--color-cover-to, var(--color-accent-soft)))"></div>
        <div style="padding:0 var(--space-8) var(--space-8)">
            <div style="display:flex;align-items:flex-end;gap:var(--space-5);margin-top:-46px;flex-wrap:wrap">
                <span class="nc-avatar nc-avatar--xl" style="width:108px;height:108px;border:4px solid var(--color-surface);background:var(--color-primary-soft);color:var(--color-primary-soft-text);box-shadow:var(--shadow-md)">
                    @Model.Initials
                </span>
                <div style="flex:1;min-width:240px;padding-bottom:var(--space-1)">
                    <div style="display:flex;align-items:center;gap:var(--space-2);flex-wrap:wrap">
                        <h1 style="font-size:var(--text-2xl);font-weight:var(--weight-extra);margin:0;letter-spacing:var(--tracking-tight);white-space:nowrap">@Model.DisplayName</h1>
                        @if (Model.CrnVerified)
                        {
                            <span class="nc-badge nc-badge--teal">CRN verificado</span>
                        }
                    </div>
                    <p class="muted" style="margin:var(--space-1) 0 0">
                        @Model.ProfessionalTitle
                        @if (Model.MainSpecialty.HasValue) { <text> · @Model.MainSpecialty.Value.GetDisplayName()</text> }
                        @if (!string.IsNullOrEmpty(Model.CrnRegistration)) { <text> · @Model.CrnRegistration</text> }
                        @if (!string.IsNullOrEmpty(Model.City)) { <text> · @Model.City</text> }
                    </p>
                    @if (Model.ReviewCount > 0)
                    {
                        <div class="nc-rating" style="margin-top:var(--space-2)">
                            @Html.Raw(Stars((int)Math.Round(Model.AverageRating!.Value)))
                            <span class="nc-rating__value">@Model.AverageDisplay</span>
                            <span class="nc-rating__count">· @Model.ReviewCount avaliaç@(Model.ReviewCount == 1 ? "ão" : "ões")</span>
                        </div>
                    }
                </div>
                @if (Model.CanMessage)
                {
                    <button type="button" class="nc-btn nc-btn--primary" style="margin-bottom:var(--space-1)"
                            onclick="window.ncChat?.startWith(@Model.Id)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                        Enviar mensagem
                    </button>
                }
            </div>
            <div class="prof-stats">
                @if (Model.YearsOfExperience > 0)
                {
                    <div><div class="v">@Model.YearsOfExperience anos</div><div class="l">experiência</div></div>
                }
                @if (Model.Specialties.Count > 0)
                {
                    <div><div class="v">@Model.Specialties.Count</div><div class="l">especialidades</div></div>
                }
                @if (Model.Credentials.Count > 0)
                {
                    <div><div class="v">@Model.Credentials.Count</div><div class="l">formações</div></div>
                }
            </div>
        </div>
    </section>

    <div class="cols cols--detail">
        <div>
            <div class="nc-tabs" style="margin-bottom:var(--space-5)">
                <button class="nc-tab nc-tab--active" data-tab="sobre">Sobre</button>
                <button class="nc-tab" data-tab="especialidades">Especialidades</button>
                <button class="nc-tab" data-tab="avaliacoes">Avaliações@(Model.ReviewCount > 0 ? $" ({Model.ReviewCount})" : "")</button>
            </div>

            <div class="pane on" data-pane="sobre">
                @if (!string.IsNullOrWhiteSpace(Model.About))
                {
                    <section class="nc-card nc-card--pad" style="margin-bottom:var(--space-5)">
                        <h2 class="section-title">Sobre</h2>
                        <p class="muted" style="line-height:var(--leading-relaxed);margin:0;white-space:pre-line">@Model.About</p>
                    </section>
                }

                @if (Model.Credentials.Count > 0)
                {
                    <section class="nc-card nc-card--pad">
                        <h2 class="section-title">Formação &amp; credenciais</h2>
                        @foreach (var cred in Model.Credentials)
                        {
                            <div class="credline">
                                <span class="credline__ic">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;color:var(--color-primary)">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                                    </svg>
                                </span>
                                <div style="font-weight:var(--weight-semibold);font-size:var(--text-sm)">@cred</div>
                            </div>
                        }
                    </section>
                }

                @if (Model.Credentials.Count == 0 && string.IsNullOrWhiteSpace(Model.About))
                {
                    <div class="nc-card nc-card--pad" style="text-align:center;color:var(--color-text-muted)">
                        <p style="margin:0">Este profissional ainda não preencheu seu perfil completo.</p>
                    </div>
                }
            </div>

            <div class="pane" data-pane="especialidades">
                @if (Model.Specialties.Count > 0)
                {
                    <section class="nc-card nc-card--pad" style="margin-bottom:var(--space-5)">
                        <h2 class="section-title">Áreas de atuação</h2>
                        <div class="spec-grid">
                            @foreach (var spec in Model.Specialties)
                            {
                                <div class="spec-item">
                                    <span style="width:30px;height:30px;flex:none;border-radius:var(--radius-full);background:var(--color-surface);display:grid;place-items:center;box-shadow:var(--shadow-xs)">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;color:var(--color-primary)">
                                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                                        </svg>
                                    </span>
                                    @spec.GetDisplayName()
                                </div>
                            }
                        </div>
                    </section>
                }

                <section class="nc-card nc-card--pad">
                    <h2 class="section-title">Como funciona o atendimento</h2>
                    @if (Model.AcceptsOnline)
                    {
                        <div class="credline">
                            <span class="credline__ic">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;color:var(--color-primary)">
                                    <path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2" ry="2"/>
                                </svg>
                            </span>
                            <div>
                                <div style="font-weight:var(--weight-bold);font-size:var(--text-sm)">Consulta online por vídeo</div>
                                <div class="subtle" style="font-size:var(--text-xs)">@((int)Model.SessionDurationMinutes) minutos</div>
                            </div>
                        </div>
                    }
                    @if (Model.AcceptsInPerson)
                    {
                        <div class="credline">
                            <span class="credline__ic">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;color:var(--color-primary)">
                                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
                                </svg>
                            </span>
                            <div>
                                <div style="font-weight:var(--weight-bold);font-size:var(--text-sm)">Atendimento presencial</div>
                                <div class="subtle" style="font-size:var(--text-xs)">@((int)Model.SessionDurationMinutes) minutos</div>
                            </div>
                        </div>
                    }
                    @if (!Model.AcceptsOnline && !Model.AcceptsInPerson)
                    {
                        <p class="muted" style="margin:0">Modalidades de atendimento a definir.</p>
                    }
                </section>
            </div>

            <div class="pane" data-pane="avaliacoes">
                <section class="nc-card nc-card--pad">
                    <h2 class="section-title">Avaliações de pacientes</h2>

                    @if (Model.ReviewCount > 0)
                    {
                        <div class="rating-summary">
                            <div class="rating-summary__avg">
                                <div class="big">@Model.AverageDisplay</div>
                                <div class="nc-rating" style="justify-content:center;margin-top:var(--space-2)">@Html.Raw(Stars((int)Math.Round(Model.AverageRating!.Value)))</div>
                                <div class="subtle" style="font-size:var(--text-xs);margin-top:var(--space-1)">@Model.ReviewCount avaliaç@(Model.ReviewCount == 1 ? "ão" : "ões")</div>
                            </div>
                            <div class="rating-dist">
                                @foreach (var b in Model.Distribution)
                                {
                                    <div class="rating-dist__row">
                                        <span style="width:10px;font-weight:600">@b.Star</span>
                                        <div class="nc-progress" style="flex:1;height:8px"><div class="nc-progress__bar nc-progress__bar--coral" style="width:@b.Percent%"></div></div>
                                        <span class="subtle mono" style="width:34px;text-align:right">@b.Percent%</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="muted" style="margin:0 0 var(--space-5)">Este profissional ainda não recebeu avaliações. Seja o primeiro a avaliar.</p>
                    }

                    @if (Model.CanReview)
                    {
                        <div class="nc-card" style="background:var(--color-surface-sunken);border:none;padding:var(--space-5);margin-bottom:var(--space-6)">
                            <form method="post" asp-controller="Nutritionist" asp-action="Review">
                                <input type="hidden" name="NutritionistId" value="@Model.Id" />
                                <div style="font-weight:var(--weight-bold);margin-bottom:var(--space-3)">Você foi atendido(a) por @Model.DisplayName? Deixe seu feedback</div>
                                <div style="display:flex;align-items:center;gap:var(--space-4);flex-wrap:wrap">
                                    <div class="starpick" id="my-stars">
                                        @for (var v = 1; v <= 5; v++)
                                        {
                                            <label data-v="@v">
                                                <input type="radio" name="Rating" value="@v" required />
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.6 5.9 20.8l1.2-6.8-5-4.8 6.9-.9z"/></svg>
                                            </label>
                                        }
                                    </div>
                                    <span class="subtle" id="my-label" style="font-size:var(--text-sm)">Toque nas estrelas para dar sua nota</span>
                                </div>
                                <textarea class="nc-textarea" name="Comment" maxlength="1000" style="margin-top:var(--space-4)" placeholder="Conte como foi o acompanhamento… (opcional)"></textarea>
                                <div style="display:flex;align-items:center;justify-content:space-between;margin-top:var(--space-3);gap:var(--space-3);flex-wrap:wrap">
                                    <label class="nc-check">
                                        <input type="checkbox" name="IsAnonymous" value="true" />
                                        <span class="nc-box">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="nc-box__check"><polyline points="20 6 9 17 4 12"/></svg>
                                        </span>
                                        Avaliação anônima
                                    </label>
                                    <button type="submit" class="nc-btn nc-btn--primary">Enviar feedback</button>
                                </div>
                            </form>
                        </div>
                    }
                    else if (Model.AlreadyReviewed)
                    {
                        <div class="nc-alert nc-alert--info" style="margin-bottom:var(--space-6)">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;width:16px;height:16px"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                            <div>Você já avaliou este profissional.</div>
                        </div>
                    }

                    @foreach (var review in Model.Reviews)
                    {
                        <div class="review">
                            <div class="review__head">
                                <span class="nc-avatar nc-avatar--sm" style="background:var(--color-primary-soft);color:var(--color-primary-soft-text)">@review.AuthorInitials</span>
                                <div style="flex:1">
                                    <div style="font-weight:var(--weight-bold);font-size:var(--text-sm)">@review.AuthorName</div>
                                    <div class="subtle" style="font-size:var(--text-xs)">@RelativeTime(review.CreatedAt)</div>
                                </div>
                                <span class="nc-rating">@Html.Raw(Stars(review.Rating))</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="muted" style="margin:0;line-height:var(--leading-relaxed)">@review.Comment</p>
                            }
                            @if (review.CanDelete)
                            {
                                <form method="post" asp-controller="Nutritionist" asp-action="DeleteReview" style="margin-top:var(--space-2)"
                                      data-confirm="Tem certeza que deseja excluir sua avaliação? Esta ação não pode ser desfeita."
                                      data-confirm-title="Excluir avaliação" data-confirm-ok="Excluir" data-confirm-danger="true">
                                    <input type="hidden" name="reviewId" value="@review.Id" />
                                    <input type="hidden" name="nutritionistId" value="@Model.Id" />
                                    <button type="submit" class="nc-btn nc-btn--ghost nc-btn--sm">Excluir avaliação</button>
                                </form>
                            }
                        </div>
                    }
                </section>
            </div>
        </div>

        <aside class="sticky">
            <div class="nc-card nc-card--pad">
                <div style="display:flex;align-items:baseline;gap:var(--space-2)">
                    <span style="font-size:var(--text-2xl);font-weight:var(--weight-extra)">@price</span>
                    @if (Model.PricePerSession > 0)
                    {
                        <span class="subtle" style="font-size:var(--text-sm)">/ consulta</span>
                    }
                </div>
                <dl style="margin:var(--space-5) 0;display:flex;flex-direction:column;gap:var(--space-3);font-size:var(--text-sm)">
                    <div style="display:flex;justify-content:space-between">
                        <dt class="muted">Modalidade</dt>
                        <dd style="margin:0;font-weight:var(--weight-semibold)">@Model.Modality</dd>
                    </div>
                    @if ((int)Model.SessionDurationMinutes > 0)
                    {
                        <div style="display:flex;justify-content:space-between">
                            <dt class="muted">Duração</dt>
                            <dd style="margin:0;font-weight:var(--weight-semibold)">@((int)Model.SessionDurationMinutes) minutos</dd>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.CrnRegistration))
                    {
                        <div style="display:flex;justify-content:space-between">
                            <dt class="muted">CRN</dt>
                            <dd style="margin:0;font-weight:var(--weight-semibold)">@Model.CrnRegistration</dd>
                        </div>
                    }
                </dl>
                <div class="nc-alert nc-alert--info" style="margin-top:var(--space-2)">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;width:16px;height:16px">
                        <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
                    </svg>
                    <div>Agendamento online em breve.</div>
                </div>
            </div>
        </aside>
    </div>
</main>

@section Scripts {
<script>
    function activateTab(name) {
        document.querySelectorAll('.nc-tab[data-tab]').forEach(t => t.classList.toggle('nc-tab--active', t.dataset.tab === name));
        document.querySelectorAll('.pane').forEach(p => p.classList.toggle('on', p.dataset.pane === name));
    }
    document.querySelectorAll('.nc-tab[data-tab]').forEach(tab =>
        tab.addEventListener('click', () => activateTab(tab.dataset.tab)));

    const picker = document.getElementById('my-stars');
    if (picker) {
        const LABELS = { 1: 'Não gostei', 2: 'Regular', 3: 'Bom', 4: 'Muito bom', 5: 'Excelente!' };
        const lbl = document.getElementById('my-label');
        let rating = 0;
        const paint = v => picker.querySelectorAll('label').forEach(l => l.classList.toggle('on', +l.dataset.v <= v));
        picker.querySelectorAll('label').forEach(l => {
            l.addEventListener('mouseenter', () => { paint(+l.dataset.v); lbl.textContent = LABELS[+l.dataset.v]; });
            l.querySelector('input').addEventListener('change', () => { rating = +l.dataset.v; paint(rating); lbl.textContent = LABELS[rating]; });
        });
        picker.addEventListener('mouseleave', () => { paint(rating); lbl.textContent = rating ? LABELS[rating] : 'Toque nas estrelas para dar sua nota'; });
    }

    @if (!string.IsNullOrEmpty(reviewMsg))
    {
        <text>activateTab('avaliacoes');</text>
    }
</script>
}

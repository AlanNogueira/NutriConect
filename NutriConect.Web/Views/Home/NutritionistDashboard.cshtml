@model NutriConect.Business.ViewModels.NutritionistDashboardViewModel
@using NutriConect.Business.Extensions
@{
    Layout = "_NcLayout";
    ViewData["Title"] = "Início";
    ViewData["ActiveNav"] = "inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
}

@functions {
    const string FullStar = "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\" style=\"width:16px;height:16px;color:var(--color-warning,#f59e0b)\"><path d=\"m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.6 5.9 20.8l1.2-6.8-5-4.8 6.9-.9z\"/></svg>";
    const string EmptyStar = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\" style=\"width:16px;height:16px;color:var(--color-border)\"><path d=\"m12 2 3 6.3 6.9.9-5 4.8 1.2 6.8L12 17.6 5.9 20.8l1.2-6.8-5-4.8 6.9-.9z\"/></svg>";

    static string Stars(int filled)
    {
        var html = "";
        for (var i = 1; i <= 5; i++) html += i <= filled ? FullStar : EmptyStar;
        return html;
    }

    static string RelativeTime(DateTimeOffset when)
    {
        var diff = DateTimeOffset.UtcNow - when;
        if (diff.TotalMinutes < 1) return "agora";
        if (diff.TotalMinutes < 60) return $"há {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24) return $"há {(int)diff.TotalHours} h";
        if (diff.TotalDays < 2) return "ontem";
        if (diff.TotalDays < 7) return $"há {(int)diff.TotalDays} dias";
        return when.ToLocalTime().ToString("dd/MM/yyyy");
    }
}

<main class="page">
    <header class="page-head" style="display:flex;align-items:flex-end;justify-content:space-between;gap:var(--space-4);flex-wrap:wrap">
        <div>
            <div style="display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap">
                <h1 style="margin:0">Olá, @Model.DisplayName!</h1>
                @if (Model.MainSpecialty.HasValue)
                {
                    <span class="nc-badge nc-badge--teal">@Model.MainSpecialty.Value.GetDisplayName()</span>
                }
                @if (Model.AvailableForNewPatients)
                {
                    <span class="nc-badge nc-badge--success nc-badge--dot">Aceitando novos pacientes</span>
                }
            </div>
            <p style="margin-top:var(--space-2)">Acompanhe sua presença na plataforma.</p>
        </div>
        <div style="display:flex;gap:var(--space-2);flex-wrap:wrap">
            <a class="nc-btn nc-btn--accent" asp-controller="Recipe" asp-action="Create">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Nova receita
            </a>
            <a class="nc-btn nc-btn--secondary" asp-controller="Tip" asp-action="Index">Compartilhar dica</a>
            <a class="nc-btn nc-btn--outline" asp-controller="Nutritionist" asp-action="Profile">Editar perfil</a>
            <a class="nc-btn nc-btn--ghost" asp-controller="Nutritionist" asp-action="Public" asp-route-id="@Model.Id">Ver perfil público</a>
        </div>
    </header>

    <partial name="_SuccessAlert" model="@(TempData["Success"] as string)" />

    <div class="dash-metrics">
        <div class="nc-card nc-card--pad">
            <div class="dash-metric__value">
                @if (Model.ReviewCount > 0)
                {
                    @Model.AverageDisplay
                    <span class="nc-rating">@Html.Raw(Stars((int)Math.Round(Model.AverageRating)))</span>
                }
                else
                {
                    <span class="subtle">—</span>
                }
            </div>
            <div class="dash-metric__label">@(Model.ReviewCount > 0 ? $"{Model.ReviewCount} avaliaç{(Model.ReviewCount == 1 ? "ão" : "ões")}" : "Sem avaliações ainda")</div>
        </div>
        <div class="nc-card nc-card--pad">
            <div class="dash-metric__value">@Model.PublishedRecipes</div>
            <div class="dash-metric__label">Receita@(Model.PublishedRecipes == 1 ? "" : "s") publicada@(Model.PublishedRecipes == 1 ? "" : "s")</div>
        </div>
        <div class="nc-card nc-card--pad">
            <div class="dash-metric__value">@Model.PublishedTips</div>
            <div class="dash-metric__label">Dica@(Model.PublishedTips == 1 ? "" : "s") compartilhada@(Model.PublishedTips == 1 ? "" : "s")</div>
        </div>
        <div class="nc-card nc-card--pad">
            <div class="dash-metric__value">@Model.UnreadMessages</div>
            <div class="dash-metric__label">Mensage@(Model.UnreadMessages == 1 ? "m" : "ns") não lida@(Model.UnreadMessages == 1 ? "" : "s")</div>
        </div>
    </div>

    <div class="cols cols--2" style="align-items:start">
        <section class="nc-card nc-card--pad">
            <div class="dash-card__head">
                <h2>Avaliações recentes</h2>
                <a class="nc-btn nc-btn--ghost nc-btn--sm" asp-controller="Nutritionist" asp-action="Public" asp-route-id="@Model.Id">Ver todas</a>
            </div>
            @if (Model.RecentReviews.Count == 0)
            {
                <p class="dash-empty" style="margin:0">Você ainda não recebeu avaliações. Elas aparecem aqui quando um cliente avaliar seu perfil.</p>
            }
            else
            {
                @foreach (var review in Model.RecentReviews)
                {
                    <div class="dash-row">
                        <span class="nc-avatar nc-avatar--sm">@review.AuthorInitials</span>
                        <div class="dash-row__info">
                            <div style="display:flex;align-items:center;gap:var(--space-2);flex-wrap:wrap">
                                <span class="dash-row__name">@review.AuthorName</span>
                                <span class="nc-rating">@Html.Raw(Stars(review.Rating))</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="muted" style="margin:var(--space-1) 0 0;font-size:var(--text-sm);line-height:var(--leading-relaxed);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">@review.Comment</p>
                            }
                        </div>
                        <span class="dash-row__time">@RelativeTime(review.CreatedAt)</span>
                    </div>
                }
            }
        </section>

        <section class="nc-card nc-card--pad">
            <div class="dash-card__head">
                <h2>
                    Mensagens
                    @if (Model.UnreadMessages > 0)
                    {
                        <span class="nc-badge nc-badge--teal">@Model.UnreadMessages não lida@(Model.UnreadMessages == 1 ? "" : "s")</span>
                    }
                </h2>
                <button type="button" class="nc-btn nc-btn--ghost nc-btn--sm"
                        onclick="document.getElementById('chatwLauncher')?.click()">Abrir chat</button>
            </div>
            @if (Model.RecentConversations.Count == 0)
            {
                <p class="dash-empty" style="margin:0">Nenhuma conversa ainda. Quando um cliente entrar em contato, ela aparece aqui.</p>
            }
            else
            {
                <partial name="_DashboardConversations" model="Model.RecentConversations" />
            }
        </section>
    </div>
</main>

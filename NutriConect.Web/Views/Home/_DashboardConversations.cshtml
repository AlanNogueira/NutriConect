@model List<NutriConect.Business.ViewModels.ConversationListItemViewModel>

@functions {
    static string RelativeTime(DateTimeOffset when)
    {
        var diff = DateTimeOffset.UtcNow - when;
        if (diff.TotalMinutes < 1) return "agora";
        if (diff.TotalMinutes < 60) return $"há {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24) return $"há {(int)diff.TotalHours} h";
        if (diff.TotalDays < 2) return "ontem";
        if (diff.TotalDays < 7) return $"há {(int)diff.TotalDays} dias";
        return when.ToLocalTime().ToString("dd/MM/yyyy");
    }
}

<div>
    @foreach (var c in Model)
    {
        <div class="dash-row" style="align-items:center">
            <span class="nc-avatar nc-avatar--sm">@c.OtherInitials</span>
            <div class="dash-row__info">
                <div class="dash-row__name">@c.OtherName</div>
                @if (!string.IsNullOrWhiteSpace(c.LastMessagePreview))
                {
                    <div class="dash-row__preview">@c.LastMessagePreview</div>
                }
            </div>
            @if (c.UnreadCount > 0)
            {
                <span class="nc-badge nc-badge--teal">@c.UnreadCount</span>
            }
            <span class="dash-row__time">@RelativeTime(c.LastMessageAt)</span>
        </div>
    }
</div>

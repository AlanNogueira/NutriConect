@model NutriConect.Business.ViewModels.ClientDashboardViewModel
@using NutriConect.Business.Extensions
@{
    Layout = "_NcLayout";
    ViewData["Title"] = "Início";
    ViewData["ActiveNav"] = "inicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/recipe-card.css" asp-append-version="true" />
}

@functions {
    static string RelativeTime(DateTimeOffset when)
    {
        var diff = DateTimeOffset.UtcNow - when;
        if (diff.TotalMinutes < 1) return "agora";
        if (diff.TotalMinutes < 60) return $"há {(int)diff.TotalMinutes} min";
        if (diff.TotalHours < 24) return $"há {(int)diff.TotalHours} h";
        if (diff.TotalDays < 2) return "ontem";
        if (diff.TotalDays < 7) return $"há {(int)diff.TotalDays} dias";
        return when.ToLocalTime().ToString("dd/MM/yyyy");
    }
}

<main class="page">
    <header class="page-head">
        <div style="display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap">
            <h1 style="margin:0">Olá, @Model.FirstName!</h1>
            <span class="nc-badge nc-badge--teal nc-badge--dot">@Model.MainGoal.GetDisplayName()</span>
        </div>
        <p style="margin-top:var(--space-2)">Bem-vindo de volta. Continue cuidando da sua alimentação.</p>
    </header>

    <partial name="_SuccessAlert" model="@(TempData["Success"] as string)" />

    <div class="cols cols--3" style="margin-bottom:var(--space-8)">
        <a class="nc-card nc-card--pad nc-card--hover" asp-controller="Nutritionist" asp-action="Search" style="text-decoration:none;color:inherit">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:24px;height:24px;margin-bottom:var(--space-3)"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <h3 style="margin:0 0 var(--space-1);font-size:var(--text-md)">Buscar nutricionista</h3>
            <p class="muted" style="margin:0;font-size:var(--text-sm)">Encontre o profissional ideal para o seu objetivo.</p>
        </a>
        <a class="nc-card nc-card--pad nc-card--hover" asp-controller="Recipe" asp-action="Index" style="text-decoration:none;color:inherit">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:24px;height:24px;margin-bottom:var(--space-3)"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
            <h3 style="margin:0 0 var(--space-1);font-size:var(--text-md)">Receitas</h3>
            <p class="muted" style="margin:0;font-size:var(--text-sm)">Explore receitas saudáveis da comunidade.</p>
        </a>
        <a class="nc-card nc-card--pad nc-card--hover" asp-controller="Tip" asp-action="Index" style="text-decoration:none;color:inherit">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:24px;height:24px;margin-bottom:var(--space-3)"><path d="M9 18h6" /><path d="M10 22h4" /><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.4 1 2.3h6c0-.9.4-1.8 1-2.3A7 7 0 0 0 12 2z" /></svg>
            <h3 style="margin:0 0 var(--space-1);font-size:var(--text-md)">Dicas</h3>
            <p class="muted" style="margin:0;font-size:var(--text-sm)">Dicas rápidas de quem entende de nutrição.</p>
        </a>
    </div>

    <div class="cols cols--2" style="margin-bottom:var(--space-8);align-items:start">
        <section class="nc-card nc-card--pad">
            <div class="dash-card__head">
                <h2>
                    Mensagens
                    @if (Model.UnreadMessages > 0)
                    {
                        <span class="nc-badge nc-badge--teal">@Model.UnreadMessages não lida@(Model.UnreadMessages == 1 ? "" : "s")</span>
                    }
                </h2>
                <button type="button" class="nc-btn nc-btn--ghost nc-btn--sm"
                        onclick="document.getElementById('chatwLauncher')?.click()">Abrir chat</button>
            </div>
            @if (Model.RecentConversations.Count == 0)
            {
                <p class="dash-empty" style="margin:0">
                    Nenhuma conversa ainda.
                    <a asp-controller="Nutritionist" asp-action="Search" style="color:var(--color-primary-soft-text)">Encontre um nutricionista</a> para começar.
                </p>
            }
            else
            {
                <partial name="_DashboardConversations" model="Model.RecentConversations" />
            }
        </section>

        <section class="nc-card nc-card--pad">
            <div class="dash-card__head">
                <h2>Dicas de profissionais</h2>
                <a class="nc-btn nc-btn--ghost nc-btn--sm" asp-controller="Tip" asp-action="Index" asp-route-onlyProfessionals="true">Ver todas</a>
            </div>
            @if (Model.RecentTips.Count == 0)
            {
                <p class="dash-empty" style="margin:0">Nenhuma dica publicada ainda.</p>
            }
            else
            {
                @foreach (var tip in Model.RecentTips)
                {
                    <div class="dash-row">
                        <span class="nc-avatar nc-avatar--sm">@tip.AuthorInitials</span>
                        <div class="dash-row__info">
                            <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                                <span class="dash-row__name">@tip.AuthorName</span>
                                <span class="nc-badge nc-badge--teal nc-badge--dot">Nutri</span>
                            </div>
                            <p class="muted" style="margin:var(--space-1) 0 0;font-size:var(--text-sm);line-height:var(--leading-relaxed);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">@tip.Body</p>
                        </div>
                        <span class="dash-row__time">@RelativeTime(tip.CreatedAt)</span>
                    </div>
                }
            }
        </section>
    </div>

    <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);flex-wrap:wrap">
        <h2 class="section-title" style="margin:0">Receitas em destaque</h2>
        <a class="nc-btn nc-btn--ghost nc-btn--sm" asp-controller="Recipe" asp-action="Index">Ver todas</a>
    </div>
    @if (Model.FeaturedRecipes.Count == 0)
    {
        <p class="dash-empty" style="margin-top:var(--space-3)">Nenhuma receita publicada ainda.</p>
    }
    else
    {
        <section class="recipe-grid" style="margin-top:var(--space-4)">
            @foreach (var r in Model.FeaturedRecipes)
            {
                <a class="nc-card nc-card--hover recipe-card" asp-controller="Recipe" asp-action="Details" asp-route-id="@r.Id">
                    <div class="recipe-card__cover imgph">foto do prato</div>
                    <div class="recipe-card__body">
                        @if (r.ApprovedByNutritionist)
                        {
                            <span class="nc-badge nc-badge--success nc-badge--dot" style="align-self:flex-start">Aprovada por nutricionista</span>
                        }
                        <h3>@r.Title</h3>
                        <div class="meta-row">
                            @if (r.PrepMinutes.HasValue)
                            {
                                <span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><polyline points="12 7 12 12 16 14" /></svg>
                                    @r.PrepMinutes min
                                </span>
                            }
                            @if (r.CaloriesPerServing.HasValue)
                            {
                                <span>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8 6 6 9 6 13a6 6 0 0 0 12 0c0-2-1-4-2-5-1 2-2 2.5-3 2.5C12 8 13 5 12 2z" /></svg>
                                    @r.CaloriesPerServing kcal
                                </span>
                            }
                        </div>
                        @if (r.Categories.Any())
                        {
                            <div class="tag-row">
                                @foreach (var cat in r.Categories)
                                {
                                    <span class="nc-badge nc-badge--neutral">@cat.GetDisplayName()</span>
                                }
                            </div>
                        }
                        <span class="subtle" style="font-size:var(--text-xs);margin-top:auto">por @r.AuthorName</span>
                    </div>
                </a>
            }
        </section>
    }
</main>
